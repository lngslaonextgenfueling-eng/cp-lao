generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum ShopStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum Category {
  CPU
  MAINBOARD
  RAM
  GPU
  PSU
  STORAGE
  CASE
  LAPTOP
  DESKTOP
  MONITOR
  ACCESSORY
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QR
  TRANSFER
  COD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(CUSTOMER)
  phone        String?
  createdAt    DateTime @default(now())
  orders       Order[]
  shop         Shop?
}

model Shop {
  id                String     @id @default(cuid())
  ownerId           String     @unique
  owner             User       @relation(fields: [ownerId], references: [id])
  name              String
  slug              String     @unique
  description       String     @default("")
  phone             String?
  address           String?
  logo              String?
  bankName          String?
  accountName       String?
  accountNo         String?
  status            ShopStatus @default(PENDING)
  commissionPercent Int        @default(5) // platform fee % taken from each order
  createdAt         DateTime   @default(now())
  products          Product[]
  orders            Order[]
}

model Product {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id])
  name        String
  brand       String
  category    Category
  price       Int // LAK
  stock       Int         @default(0)
  image       String?
  description String      @default("")
  cpu         String? // filter helper e.g. "Intel Core i5"
  ramGb       Int?
  storageGb   Int?
  gpu         String?
  usage       String[] // GAMING | WORKING | GRAPHIC
  specs       Json        @default("{}") // free-form tech specs + compatibility fields
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([category])
  @@index([brand])
  @@index([shopId])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  percent   Int
  active    Boolean   @default(true)
  expiresAt DateTime?
}

model Order {
  id             String        @id @default(cuid())
  groupId        String // orders created by one checkout share a groupId
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id])
  status         OrderStatus   @default(PENDING)
  subtotal       Int
  discount       Int           @default(0)
  shippingFee    Int           @default(0)
  total          Int
  platformFee    Int           @default(0) // commission kept by the platform
  couponCode     String?
  paymentMethod  PaymentMethod
  shippingMethod String
  recipient      String
  phone          String
  address        String
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]

  @@index([userId])
  @@index([shopId])
  @@index([groupId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  qty       Int
}
