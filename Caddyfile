# Caddy gets and renews the HTTPS certificate (Let's Encrypt) automatically.
{$DOMAIN} {
	encode gzip zstd

	# API requests go to the Express backend
	handle /api/* {
		reverse_proxy backend:4000
	}

	# everything else is the Next.js website
	handle {
		reverse_proxy frontend:3000
	}
}

# www.example.com -> example.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
